*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
.env/
pip-log.txt
pip-delete-this-directory.txt

# Environment variables
.env
.env.local
.env.*.local

# =========================
# Jupyter Notebook & Data Science
# =========================
.ipynb_checkpoints/
profile_default/
ipython_config.py

# =========================
# Data, Models, and Outputs
# =========================
# Tránh đẩy dữ liệu thực tế và model weights lên Git vì dung lượng lớn
data/*
!data/.gitkeep
!data/sample_*/  # Bỏ comment dòng này nếu bạn muốn giữ lại thư mục chứa dữ liệu mẫu

models/*
!models/.gitkeep

!outputs/.gitkeep

